@inherits EmailVerificationBase

<MudDialog Class="rounded-xl">
    <TitleContent>
        <div class="flex flex-col">
            <MudText Typo="Typo.h5" Class="mb-1 font-bold text-gray-900">Verify Your Email</MudText>
            <MudText Typo="Typo.body2" Class="text-gray-600">
                Enter the 6-digit verification code sent to your email.
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <Loader Visible="isLoading" />

        <MudForm @ref="form" @bind-IsValid="success">
            <div class="space-y-4 py-4">
                <MudTextField @bind-Value="code"
                              Variant="Variant.Outlined"
                              Placeholder="Enter verification code"
                              Required="true"
                              RequiredError="Verification code is required"
                              MaxLength="6"
                              Style="background-color: #f0fdf4;"
                              Class="rounded-lg" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           FullWidth="true"
                           Disabled="isLoading"
                           OnClick="VerifyEmail"
                           Class="rounded-lg"
                           Style="text-transform: none; font-weight: 600; padding: 12px;">
                    @if (isLoading)
                    {
                        <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                            <span>Verifying...</span>
                        </MudStack>
                    }
                    else
                    {
                        <span>Verify Email</span>
                    }
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           FullWidth="true"
                           Disabled="isResending"
                           OnClick="ResendCode"
                           Class="rounded-lg">
                    @if (isResending)
                    {
                        <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                            <span>Resending...</span>
                        </MudStack>
                    }
                    else
                    {
                        <span>Resend Code</span>
                    }
                </MudButton>
            </div>
        </MudForm>
    </DialogContent>
</MudDialog>
