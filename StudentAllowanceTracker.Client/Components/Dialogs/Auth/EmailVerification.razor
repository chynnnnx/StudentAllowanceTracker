@using MudBlazor
@inject IEmailServices EmailServices
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <div class="flex flex-col justify-center items-center p-6 bg-white rounded-2xl w-full max-w-md">
            <h2 class="text-2xl font-semibold text-center mb-4">Verify Your Email</h2>
            <p class="text-gray-600 text-center mb-6">
                Enter the 6-digit verification code sent to your email.
            </p>

            <input @bind="code"
                   placeholder="Verification code"
                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none mb-4" />

            <button @onclick="VerifyEmail"
                    disabled="@isLoading"
                    class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition disabled:opacity-50">
                @(isLoading ? "Verifying..." : "Verify Email")
            </button>

            <button @onclick="ResendCode"
                    disabled="@isResending"
                    class="w-full mt-3 border border-gray-300 py-2 rounded-lg hover:bg-gray-100 transition disabled:opacity-50">
                @(isResending ? "Resending..." : "Resend Code")
            </button>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Email { get; set; } = string.Empty;

    private string code = string.Empty;
    private bool isLoading = false;
    private bool isResending = false;

    private async Task VerifyEmail()
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            Snackbar.Add("Please enter your verification code.", Severity.Warning);
            return;
        }

        isLoading = true;

        var dto = new EmailVerificationDTO
            {
                Email = Email,
                Code = code
            };

        bool success = await EmailServices.VerifyEmailAsync(dto);
        isLoading = false;

        if (success)
        {
            Snackbar.Add("Email verified successfully!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("Invalid or expired code. Please try again.", Severity.Error);
        }
    }

    private async Task ResendCode()
    {
        isResending = true;

        var dto = new EmailVerificationDTO
            {
                Email = Email,
                Code = string.Empty
            };

        bool success = await EmailServices.ResendVerificationEmailAsync(dto);
        isResending = false;

        if (success)
        {
            Snackbar.Add("Verification code resent successfully!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to resend code. Please try again later.", Severity.Error);
        }
    }
}
