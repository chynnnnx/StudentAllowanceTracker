 @inherits LoginBase

<MudDialog Class="rounded-xl" >
    <TitleContent>
        <div class="flex items-center justify-between">
            <div>
                <MudText Typo="Typo.h5" Class="font-bold text-gray-900">Welcome Back</MudText>
                <MudText Typo="Typo.body2" Class="text-gray-600">
                    Login to your ExpenseTrack account to continue tracking your expenses.
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <Loader Visible="_isLoading" />

        <div class="py-4">
            <MudForm @ref="form" @bind-IsValid="@success">
                <div class="mb-4">
                    <MudText Typo="Typo.body1" Class="mb-2 font-semibold text-gray-900">Email</MudText>
                    <MudTextField @bind-Value="loginDTO.Email"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Email is required"
                                  Placeholder="you@example.com"
                                  Style="background-color: #f0fdf4;"
                                  Class="rounded-lg" />
                </div>

                <div class="mb-2">
                    <MudText Typo="Typo.body1" Class="mb-2 font-semibold text-gray-900">Password</MudText>
                    <MudTextField @bind-Value="loginDTO.Password"
                                  InputType="@LoginPasswordField.InputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@LoginPasswordField.Icon"
                                  OnAdornmentClick="LoginPasswordField.Toggle"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Password is required"
                                  Placeholder="••••••••"
                                  Style="background-color: #f0fdf4;"
                                  Class="rounded-lg" />

                </div>

                <div class="mb-6 text-right">
                    <MudLink OnClick="HandleForgotPasswordClick" Color="Color.Success" Class="font-semibold" Style="cursor: pointer; font-size: 0.875rem;">
                        Forgot Password?
                    </MudLink>
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="HandleLogin"
                           Disabled="_isLoading"
                           Class="mb-4 rounded-lg"
                           Style="text-transform: none; font-weight: 600; padding: 12px;">
                    @(_isLoading ? "Logging in..." : "Login")
                </MudButton>


                <MudText Typo="Typo.body2" Align="Align.Center" Class="text-gray-600">
                    Don't have an account?
                    <MudLink OnClick="HandleSignUpClick" Color="Color.Success" Class="font-semibold" Style="cursor: pointer;">
                        Sign up
                    </MudLink>
                </MudText>
            </MudForm>
        </div>
    </DialogContent>
</MudDialog>
 