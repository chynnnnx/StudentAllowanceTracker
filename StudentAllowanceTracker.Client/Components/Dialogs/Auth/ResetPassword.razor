@inherits ResetPasswordBase
<MudDialog Class="rounded-xl">
    <TitleContent>
        <div class="flex items-center justify-between">
            <div>
                <MudText Typo="Typo.h5" Class="font-bold text-gray-900">Reset Password</MudText>
                <MudText Typo="Typo.body2" Class="text-gray-600">
                    Enter the 6-digit code sent to your email and your new password.
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <Loader Visible="_isLoading" />

        <div class="py-4">
            <MudForm @ref="form" @bind-IsValid="@success">
                <div class="mb-4">
                    <MudText Typo="Typo.body1" Class="mb-2 font-semibold text-gray-900">Email</MudText>
                    <MudTextField @bind-Value="resetPasswordDTO.Email"
                                  Variant="Variant.Outlined"
                                  Disabled="true"
                                  Style="background-color: #f5f5f5;"
                                  Class="rounded-lg" />

                    <MudTextField @bind-Value="resetPasswordDTO.VerificationCode"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Verification code is required"
                                  Placeholder="Enter 6-digit code"
                                  MaxLength="6"
                                  Style="background-color: #f0fdf4;"
                                  Class="rounded-lg" />
                    <MudTextField @bind-Value="resetPasswordDTO.NewPassword"
                                  InputType="@NewPasswordField.InputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@NewPasswordField.Icon"
                                  OnAdornmentClick="NewPasswordField.Toggle"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Password is required"
                                  Validation="@(new Func<string, string>(PasswordValidator.ValidatePasswordStrength))"
                                  Placeholder="••••••••"
                                  Style="background-color: #f0fdf4;"
                                  Class="rounded-lg" />

                    <MudTextField @bind-Value="resetPasswordDTO.ConfirmPassword"
                                  InputType="@ConfirmPasswordField.InputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@ConfirmPasswordField.Icon"
                                  OnAdornmentClick="ConfirmPasswordField.Toggle"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Please confirm your password"
                                  Validation="@(new Func<string, string>(value => PasswordValidator.ValidatePasswordMatch(resetPasswordDTO.NewPassword, value)))"
                                  Placeholder="••••••••"
                                  Style="background-color: #f0fdf4;"
                                  Class="rounded-lg" />


                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="HandleResetPassword"
                           Disabled="_isLoading"
                           Class="mb-4 rounded-lg"
                           Style="text-transform: none; font-weight: 600; padding: 12px;">
                    @(_isLoading ? "Resetting..." : "Reset Password")
                </MudButton>

                <MudText Typo="Typo.body2" Align="Align.Center" Class="text-gray-600">
                    Remember your password?
                    <MudLink OnClick="HandleBackToLogin" Color="Color.Success" Class="font-semibold" Style="cursor: pointer;">
                        Back to Login
                    </MudLink>
                </MudText>
            </MudForm>
        </div>
    </DialogContent>
</MudDialog>
