@inherits ForgotPasswordBase

<MudDialog Class="rounded-xl">
    <TitleContent>
        <div class="flex items-center justify-between">
            <div>
                <MudText Typo="Typo.h5" Class="font-bold text-gray-900">Forgot Password</MudText>
                <MudText Typo="Typo.body2" Class="text-gray-600">
                    Enter your email address and we'll send you a 6-digit verification code.
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <Loader Visible="_isLoading" />

        <div class="py-4">
            <MudForm @ref="form" @bind-IsValid="@success">
                <div class="mb-4">
                    <MudText Typo="Typo.body1" Class="mb-2 font-semibold text-gray-900">Email</MudText>
                    <MudTextField @bind-Value="email"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Email is required"
                                  Validation="@(new Func<string, string>(ValidateEmail))"
                                  Placeholder="you@example.com"
                                  Style="background-color: #f0fdf4;"
                                  Class="rounded-lg" />
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="HandleForgotPassword"
                           Class="mb-4 rounded-lg"
                           Style="text-transform: none; font-weight: 600; padding: 12px;">
                    Send Verification Code
                </MudButton>

                <MudText Typo="Typo.body2" Align="Align.Center" Class="text-gray-600">
                    Remember your password?
                    <MudLink OnClick="HandleBackToLogin" Color="Color.Success" Class="font-semibold" Style="cursor: pointer;">
                        Back to Login
                    </MudLink>
                </MudText>
            </MudForm>
        </div>
    </DialogContent>
</MudDialog>
 