@inject IGoalService GoalService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@isValid">
            <div class="space-y-4">

                <MudTextField @bind-Value="model.GoalName"
                              Label="Goal Name"
                              Required="true"
                              RequiredError="Goal name is required"
                              Variant="Variant.Outlined"
                              HelperText="What are you saving for?" />

                <MudTextField @bind-Value="model.Description"
                              Label="Description"
                              Lines="3"
                              Variant="Variant.Outlined"
                              HelperText="Add more details about your goal (optional)" />

                <MudNumericField @bind-Value="model.TargetAmount"
                                 Label="Target Amount"
                                 Required="true"
                                 RequiredError="Target amount is required"
                                 Min="0.01m"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="₱"
                                 Variant="Variant.Outlined"
                                 HelperText="How much do you need to save?" />

                @if (IsEditMode)
                {
                    <MudNumericField @bind-Value="model.CurrentAmount"
                                     Label="Current Amount"
                                     Min="0m"
                                     Format="N2"
                                     Adornment="Adornment.Start"
                                     AdornmentText="₱"
                                     Variant="Variant.Outlined"
                                     HelperText="How much have you saved so far?" />
                }

                <MudDatePicker @bind-Date="targetDate"
                               Label="Target Date"
                               Required="true"
                               RequiredError="Target date is required"
                               MinDate="DateTime.Today"
                               Variant="Variant.Outlined"
                               HelperText="When do you want to reach this goal?" />

            </div>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text"
                   Style="text-transform: none;">
            Cancel
        </MudButton>
        <MudButton OnClick="Submit"
                   Disabled="@(!isValid || isSaving)"
                   Variant="Variant.Filled"
                   Style="background: linear-gradient(135deg, hsl(162, 86.6%, 32.2%) 0%, hsl(162, 97%, 26.1%) 100%); color: white; text-transform: none;">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>@(IsEditMode ? "Update Goal" : "Create Goal")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public GoalDTO? Goal { get; set; }

    private GoalDTO model = new();
    private DateTime? targetDate;
    private MudForm form = null!;
    private bool isValid;
    private bool isSaving;

    private bool IsEditMode => Goal != null;

    protected override void OnInitialized()
    {
        if (IsEditMode && Goal != null)
        {
            // Editing existing goal
            model = new GoalDTO
                {
                    GoalID = Goal.GoalID,
                    UserID = Goal.UserID,
                    GoalName = Goal.GoalName,
                    Description = Goal.Description,
                    TargetAmount = Goal.TargetAmount,
                    CurrentAmount = Goal.CurrentAmount,
                    TargetDate = Goal.TargetDate
                };
            targetDate = Goal.TargetDate;
        }
        else
        {
            // Creating new goal
            model = new GoalDTO
                {
                    CurrentAmount = 0,
                    TargetDate = DateTime.Today.AddMonths(3)
                };
            targetDate = model.TargetDate;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        await form.Validate();

        if (!isValid)
        {
            Snackbar.Add("Please fill in all required fields", Severity.Warning);
            return;
        }

        if (targetDate == null)
        {
            Snackbar.Add("Please select a target date", Severity.Warning);
            return;
        }

        isSaving = true;

        try
        {
            model.TargetDate = targetDate.Value;

            bool success;
            if (IsEditMode)
            {
                var result = await GoalService.UpdateGoal(model);
                success = result != null;

                if (success)
                {
                    Snackbar.Add("Goal updated successfully!", Severity.Success);
                }
            }
            else
            {
                success = await GoalService.AddGoal(model);

                if (success)
                {
                    Snackbar.Add("Goal created successfully!", Severity.Success);
                }
            }

            if (success)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add($"Failed to {(IsEditMode ? "update" : "create")} goal", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }
}