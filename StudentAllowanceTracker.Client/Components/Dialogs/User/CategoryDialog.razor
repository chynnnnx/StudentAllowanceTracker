@inherits CategoryDialogBase

<MudDialog>
    <TitleContent>
        <div class="flex items-center gap-3">
            <MudIcon Icon="@(IsEditing ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)"
                     Class="text-success"
                     Style="font-size: 1.75rem;" />
            <MudText Typo="Typo.h6" Class="font-bold text-gray-900">
                @(IsEditing ? "Edit Category" : "Add New Category")
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="space-y-5 pt-2">
            <MudTextField @bind-Value="CategoryForm.CategoryName"
                          Label="Category Name"
                          Variant="Variant.Outlined"
                          Required="true"
                          Placeholder="e.g., Groceries, Entertainment"
                          HelperText="Give your category a descriptive name"
                          FullWidth="true" />

            <div>
                <MudText Typo="Typo.body2" Class="text-gray-700 mb-3 font-medium">
                    Category Type <span class="text-red-500">*</span>
                </MudText>
                <div class="grid grid-cols-3 gap-3">
                    <MudPaper Class="@GetTypeCardClass(CategoryType.Needs)"
                              Style="border-radius: 0.75rem;"
                              Elevation="0"
                              @onclick="async () => { CategoryForm.Type = CategoryType.Needs; await CalculateRemainingBudget(); }">
                        <div class="text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Home"
                                     Class="@GetTypeIconClass(CategoryType.Needs)"
                                     Style="font-size: 2rem;" />
                            <MudText Typo="Typo.body2" Class="font-semibold text-gray-900">Needs</MudText>
                            <MudText Typo="Typo.caption" Class="text-gray-500">@needsPercentage.ToString("F0")%</MudText>
                        </div>
                    </MudPaper>

                    <MudPaper Class="@GetTypeCardClass(CategoryType.Wants)"
                              Style="border-radius: 0.75rem;"
                              Elevation="0"
                              @onclick="async () => { CategoryForm.Type = CategoryType.Wants; await CalculateRemainingBudget(); }">
                        <div class="text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Favorite"
                                     Class="@GetTypeIconClass(CategoryType.Wants)"
                                     Style="font-size: 2rem;" />
                            <MudText Typo="Typo.body2" Class="font-semibold text-gray-900">Wants</MudText>
                            <MudText Typo="Typo.caption" Class="text-gray-500">@wantsPercentage.ToString("F0")%</MudText>
                        </div>
                    </MudPaper>

                    <MudPaper Class="@GetTypeCardClass(CategoryType.Savings)"
                              Style="border-radius: 0.75rem;"
                              Elevation="0"
                              @onclick="async () => { CategoryForm.Type = CategoryType.Savings; await CalculateRemainingBudget(); }">
                        <div class="text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Savings"
                                     Class="@GetTypeIconClass(CategoryType.Savings)"
                                     Style="font-size: 2rem;" />
                            <MudText Typo="Typo.body2" Class="font-semibold text-gray-900">Savings</MudText>
                            <MudText Typo="Typo.caption" Class="text-gray-500">@savingsPercentage.ToString("F0")%</MudText>
                        </div>
                    </MudPaper>
                </div>
                <MudText Typo="Typo.caption" Class="text-gray-500 mt-2">
                    @if (currentBudget != null)
                    {
                        <text>Choose based on your @needsPercentage.ToString("F0")/@wantsPercentage.ToString("F0")/@savingsPercentage.ToString("F0") budget plan</text>
                    }
                    else
                    {
                        <text>Choose based on the 50/30/20 budgeting rule</text>
                    }
                </MudText>
            </div>

            <div>
                <MudNumericField @bind-Value="CategoryForm.BudgetAmount"
                                 Label="Monthly Budget (Optional)"
                                 Variant="Variant.Outlined"
                                 Min="0m"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="₱"
                                 Placeholder="0.00"
                                 HelperText="Set a monthly spending limit for this category"
                                 FullWidth="true" />
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text"
                   Class="text-gray-600 font-medium"
                   Style="text-transform: none;">
            Cancel
        </MudButton>
        <MudButton OnClick="Submit"
                   Variant="Variant.Filled"
                   Disabled="@(!IsFormValid() || isSaving)"
                   Class="gradient-primary px-6 font-medium"
                   Style="color: white; text-transform: none;">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Default" />
            }
            else
            {
                <span>@(IsEditing ? "Update Category" : "Create Category")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>