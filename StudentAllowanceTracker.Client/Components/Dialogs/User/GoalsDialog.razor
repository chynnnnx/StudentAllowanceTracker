@inherits GoalsDialogBase
<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@isValid">
            <div class="space-y-4">
                <MudTextField @bind-Value="model.GoalName"
                              Label="Goal Name"
                              Required="true"
                              RequiredError="Goal name is required"
                              Variant="Variant.Outlined"
                              HelperText="What are you saving for?" />
                <MudTextField @bind-Value="model.Description"
                              Label="Description"
                              Lines="3"
                              Variant="Variant.Outlined"
                              HelperText="Add more details about your goal (optional)" />
                <MudNumericField @bind-Value="model.CurrentAmount"
                                 Label="Current Amount"
                                 Min="0m"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="₱"
                                 Variant="Variant.Outlined"
                                 HelperText="How much have you saved so far?"
                                 Immediate="true"
                                 @oninput="@(e => UpdateCompletionStatus())" />
                @if (model.IsCompleted)
                {
                    <MudText Color="Color.Success" Class="mt-2">Goal Completed!</MudText>
                }
                <MudNumericField @bind-Value="model.TargetAmount"
                                 Label="Target Amount"
                                 Required="true"
                                 Min="0.01m"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="₱"
                                 Variant="Variant.Outlined"
                                 HelperText="How much do you need to save?"
                                 Immediate="true"
                                 @oninput="@(e => UpdateCompletionStatus())" />
                <MudDatePicker @bind-Date="targetDate"
                               Label="Target Date"
                               Required="true"
                               RequiredError="Target date is required"
                               MinDate="DateTime.Today"
                               Variant="Variant.Outlined"
                               HelperText="When do you want to reach this goal?" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text"
                   Style="text-transform: none;">
            Cancel
        </MudButton>
        <MudButton OnClick="Submit"
                   Disabled="@(!isValid || isSaving)"
                   Variant="Variant.Filled"
                   Class="gradient-primary"
                   Style="color: white; text-transform: none;">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>@(IsEditMode ? "Update Goal" : "Create Goal")</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>