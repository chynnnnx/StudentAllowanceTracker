@inject IUserSubscriptionService SubscriptionService
@inject ILocalStorageService LocalStorage

<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <div class="text-center py-8">
                <MudProgressCircular Color="Color.Success" Indeterminate="true" />
                <MudText Typo="Typo.body2" Class="text-gray-500 mt-4">Processing...</MudText>
            </div>
        }
        else
        {
            @foreach (var subscription in subscriptions)
            {
                <div class="flex flex-col gap-2">
                    <MudSwitch T="bool"
                               @bind-Value="subscription.ReceiveEmail"
                               Color="Color.Success"
                               Label="Receive reminders from email" />

                    @if (subscription.ReceiveEmail)
                    {
                        <MudSelect @bind-Value="subscription.Frequency"
                                   Label="Frequency"
                                   Variant="Variant.Outlined"
                                   T="ReminderFrequency">
                            <MudSelectItem Value="ReminderFrequency.Daily">Daily</MudSelectItem>
                            <MudSelectItem Value="ReminderFrequency.Weekly">Weekly</MudSelectItem>
                        </MudSelect>
                    }
                </div>
            }
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveSubscription"
                   Disabled="@isLoading">
            @(isLoading ? "Saving..." : "Save")
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   OnClick="SendReminder"
                   Disabled="@isLoading">
            Send Now
        </MudButton>
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   OnClick="Close"
                   Disabled="@isLoading">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    private bool isLoading = false;
    private List<UserSubscriptionDTO> subscriptions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentSubscription();
    }

    private async Task LoadCurrentSubscription()
    {
        isLoading = true;
        try
        {
            subscriptions = await SubscriptionService.GetCurrentSubscription();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to load subscription settings", Severity.Warning);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSubscription()
    {
        isLoading = true;
        try
        {
            bool allSuccess = true;
            foreach (var dto in subscriptions)
            {
                var success = await SubscriptionService.SubscribeReminder(dto);
                if (!success) allSuccess = false;
            }

            if (allSuccess)
            {
                Snackbar.Add("Subscription saved successfully!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Failed to save some subscriptions", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SendReminder()
    {
        isLoading = true;
        try
        {
            var result = await SubscriptionService.SendReminder();

            if (result)
            {
                Snackbar.Add("Reminder sent successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to send reminder", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Close() => MudDialog.Cancel();
}