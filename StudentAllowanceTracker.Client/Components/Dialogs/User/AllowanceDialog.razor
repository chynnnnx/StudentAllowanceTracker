@inherits AllowanceDialogBase

<MudDialog>
    <DialogContent>
        <div class="dialog-content">

            <div class="dialog-header">
                <div class="dialog-icon-wrapper">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="dialog-icon" />
                </div>
                <MudText Typo="Typo.h5" Class="dialog-title">
                    @(IsEditMode ? "Edit Allowance" : "Add New Allowance")
                </MudText>
                <MudText Typo="Typo.body2" Class="text-secondary">
                    @(IsEditMode ? "Update your income source" : "Set up your regular income source")
                </MudText>
            </div>

            <div class="dialog-form">
                <MudNumericField @bind-Value="allowance.Amount"
                                 Label="Amount"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentText="₱"
                                 Min="0"
                                 Step="0.01M"
                                 HelperText="Enter the allowance amount"
                                 Style="width: 100%;" />

                <MudTextField @bind-Value="allowance.Description"
                              Label="Description"
                              Variant="Variant.Outlined"
                              Placeholder="e.g., Weekly allowance from parents"
                              HelperText="Add a note about this allowance"
                              Style="width: 100%;" />

                <div>
                    <MudText Typo="Typo.body2" Class="frequency-label">Frequency</MudText>
                    <div class="frequency-grid">
                        @foreach (var type in Enum.GetValues<AllowanceType>())
                        {
                            <MudCard Style="@GetTypeCardStyle(type)" @onclick="@(() => allowance.Type = type)">
                                <MudCardContent Class="frequency-card-content">
                                    <MudIcon Icon="@GetTypeIcon(type)"
                                             Style="@($"{GetTypeIconStyle(type)} margin-bottom: 0.5rem;")"
                                             Size="Size.Large" />
                                    <MudText Typo="Typo.body2" Style="@GetTypeTextStyle(type)" Class="font-medium">
                                        @type.ToString()
                                    </MudText>
                                </MudCardContent>
                            </MudCard>
                        }
                    </div>
                </div>

                <div class="date-grid">
                    <MudDatePicker Date="allowance.StartDate"
                                   DateChanged="@((DateTime? date) => allowance.StartDate = date ?? DateTime.Today)"
                                   Label="Start Date"
                                   Variant="Variant.Outlined"
                                   Editable="true"
                                   Style="width: 100%;"
                                   Color="Color.Success" />

                    <MudDatePicker Date="allowance.EndDate"
                                   DateChanged="@((DateTime? date) => allowance.EndDate = date)"
                                   Label="End Date (Optional)"
                                   Variant="Variant.Outlined"
                                   Editable="true"
                                   Clearable="true"
                                   Style="width: 100%;"
                                   Color="Color.Success"
                                   HelperText="Leave empty for ongoing" />
                </div>

                @if (allowance.Amount > 0)
                {
                    <MudAlert Severity="Severity.Info" Class="preview-alert">
                        <div class="preview-content">
                            <MudText Typo="Typo.body2" Class="preview-text">
                                You'll receive ₱@allowance.Amount.ToString("N2") @GetFrequencyText()
                            </MudText>
                        </div>
                    </MudAlert>
                }
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="dialog-actions">
            <MudButton OnClick="Cancel"
                       Variant="Variant.Outlined"
                       Class="dialog-btn-cancel">
                Cancel
            </MudButton>

            <MudButton OnClick="Submit"
                       Variant="Variant.Filled"
                       Class="dialog-btn-submit"
                       Disabled="@(!IsValid())">
                @(IsEditMode ? "Update Allowance" : "Add Allowance")
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>