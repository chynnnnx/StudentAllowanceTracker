@page "/"
@layout EmptyLayout
@inherits HomeBase

<MudAppBar Elevation="2" Fixed="true" Class="bg-white shadow-sm" Style="background-color: white;">
    <MudIconButton Icon="@Icons.Material.Filled.School" Color="Color.Success" Size="Size.Medium" Edge="Edge.Start" />
    <MudText Typo="Typo.h6" Class="font-semibold text-gray-800">
        AllowanceTrack
    </MudText>
    <MudSpacer />
    @if (IsLoggedIn)
    {
        <MudText Class="mr-2 hidden text-sm text-gray-600 sm:inline">
            Welcome, @UserName
        </MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="HandleLogout"
                   StartIcon="@Icons.Material.Filled.Logout">
            Logout
        </MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Text" OnClick="ShowLogin">
            LOGIN
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="ShowSignup">
            SIGN UP
        </MudButton>
    }
</MudAppBar>

<div class="flex flex-col">
    <div class="relative bg-white px-6 pt-40 pb-8 text-center" style="padding-top: 160px;">
        <div class="mx-auto max-w-3xl">
            <MudText Typo="Typo.h2" Class="mb-4 font-bold text-gray-800" Color="Color.Success">
                Smart Allowance Tracking for Students
            </MudText>

            <MudText Typo="Typo.subtitle1" Class="mb-8 text-gray-600">
                Take control of your finances with our easy-to-use allowance tracker.
                Perfect for students managing budgets, tracking spending, and achieving financial goals.
            </MudText>

            <div class="mb-12 flex justify-center gap-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="rounded-full px-6 py-2"
                           OnClick="ShowSignup">
                    Get Started Free
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Class="rounded-full px-6 py-2"
                           Href="#features">
                    Learn More
                </MudButton>
            </div>

            <!-- Why Students Choose Us -->
            <div class="flex flex-col justify-center gap-8 text-gray-700 sm:flex-row">
                <div class="flex flex-col items-center">
                    <div class="mb-2 inline-flex h-16 w-16 items-center justify-center rounded-full"
                         style="background-color: #d1fae5;">
                        <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-bold">Fast</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        Track in seconds
                    </MudText>
                </div>
                <div class="flex flex-col items-center">
                    <div class="mb-2 inline-flex h-16 w-16 items-center justify-center rounded-full"
                         style="background-color: #d1fae5;">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-bold">Simple</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        Easy to use
                    </MudText>
                </div>
                <div class="flex flex-col items-center">
                    <div class="mb-2 inline-flex h-16 w-16 items-center justify-center rounded-full"
                         style="background-color: #d1fae5;">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.h6" Class="font-bold">Secure</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        Your data is safe
                    </MudText>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-12"></div>

    <!-- FEATURES SECTION -->
    <div id="features" class="w-full bg-gray-50 py-20 text-center">
        <div class="mx-auto max-w-6xl px-6">
            <MudText Typo="Typo.h4" Class="mb-2 font-bold text-gray-800">
                Everything You Need to Manage Your Money
            </MudText>

            <MudText Typo="Typo.subtitle1" Class="mb-12 text-gray-600">
                Powerful features designed specifically for students to track allowances and stay on budget.
            </MudText>

            <!-- Feature Cards Grid -->
            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                <MudCard Class="p-6 shadow-sm hover:shadow-lg" Style="border: 1px solid #e5e7eb; transition: all 0.3s ease;">
                    <div class="mb-4 inline-flex rounded-2xl p-4" style="background-color: #d1fae5;">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2 font-semibold text-gray-800">Track Every Allowance</MudText>
                    <MudText Typo="Typo.body2" Class="text-gray-600">
                        Easily log all your allowances with categories like food, transport, books, and more.
                    </MudText>
                </MudCard>

                <MudCard Class="p-6 shadow-sm hover:shadow-lg" Style="border: 1px solid #e5e7eb; transition: all 0.3s ease;">
                    <div class="mb-4 inline-flex rounded-2xl p-4" style="background-color: #d1fae5;">
                        <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2 font-semibold text-gray-800">Visual Insights</MudText>
                    <MudText Typo="Typo.body2" Class="text-gray-600">
                        See a quick summary of your spending and allowances.
                    </MudText>
                </MudCard>

                <MudCard Class="p-6 shadow-sm hover:shadow-lg" Style="border: 1px solid #e5e7eb; transition: all 0.3s ease;">
                    <div class="mb-4 inline-flex rounded-2xl p-4" style="background-color: #d1fae5;">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2 font-semibold text-gray-800">Budget Management</MudText>
                    <MudText Typo="Typo.body2" Class="text-gray-600">
                        Set monthly budgets and get alerts when you're close to your limit.
                    </MudText>
                </MudCard>

                <MudCard Class="p-6 shadow-sm hover:shadow-lg" Style="border: 1px solid #e5e7eb; transition: all 0.3s ease;">
                    <div class="mb-4 inline-flex rounded-2xl p-4" style="background-color: #d1fae5;">
                        <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2 font-semibold text-gray-800">Smart Reminders</MudText>
                    <MudText Typo="Typo.body2" Class="text-gray-600">
                        Never forget to log an allowance with timely notifications.
                    </MudText>
                </MudCard>

                <MudCard Class="p-6 shadow-sm hover:shadow-lg" Style="border: 1px solid #e5e7eb; transition: all 0.3s ease;">
                    <div class="mb-4 inline-flex rounded-2xl p-4" style="background-color: #d1fae5;">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2 font-semibold text-gray-800">Secure & Private</MudText>
                    <MudText Typo="Typo.body2" Class="text-gray-600">
                        Your financial data is encrypted and stored securely.
                    </MudText>
                </MudCard>

                <MudCard Class="p-6 shadow-sm hover:shadow-lg" Style="border: 1px solid #e5e7eb; transition: all 0.3s ease;">
                    <div class="mb-4 inline-flex rounded-2xl p-4" style="background-color: #d1fae5;">
                        <MudIcon Icon="@Icons.Material.Filled.PhoneAndroid" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2 font-semibold text-gray-800">Access Anywhere</MudText>
                    <MudText Typo="Typo.body2" Class="text-gray-600">
                        Track allowances on the go with our responsive design.
                    </MudText>
                </MudCard>
            </div>
        </div>
    </div>

    <!-- HOW IT WORKS SECTION -->
    <div class="w-full bg-white py-20 text-center">
        <div class="mx-auto max-w-6xl px-6">
            <MudText Typo="Typo.h4" Class="mb-2 font-bold text-gray-800">
                Get Started in 3 Easy Steps
            </MudText>
            <MudText Typo="Typo.subtitle1" Class="mb-12 text-gray-600">
                Start tracking your allowances in minutes
            </MudText>

            <div class="grid gap-12 md:grid-cols-3">
               
                <div class="flex flex-col items-center">
                    <div class="mb-4 flex h-20 w-20 items-center justify-center rounded-full text-2xl font-bold text-white"
                         style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                        1
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2 font-semibold">Sign Up Free</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        Create your account in less than a minute. No credit card required.
                    </MudText>
                </div>

                <div class="flex flex-col items-center">
                    <div class="mb-4 flex h-20 w-20 items-center justify-center rounded-full text-2xl font-bold text-white"
                         style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                        2
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2 font-semibold">Add Your Allowances</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        Log your spending with just a few taps. Categorize automatically.
                    </MudText>
                </div>

                <div class="flex flex-col items-center">
                    <div class="mb-4 flex h-20 w-20 items-center justify-center rounded-full text-2xl font-bold text-white"
                         style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                        3
                    </div>
                    <MudText Typo="Typo.h6" Class="mb-2 font-semibold">Track & Save</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        View insights, stay on budget, and achieve your financial goals.
                    </MudText>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA SECTION -->
    <div class="w-full py-20 text-center" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
        <div class="mx-auto max-w-4xl">
            <MudText Typo="Typo.h3" Class="mb-4 font-bold text-white">
                Ready to Take Control of Your Finances?
            </MudText>
            <MudText Typo="Typo.h6" Class="mb-8 text-white" Style="opacity: 0.95;">
                Join students who are already managing their money better
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       Class="rounded-full px-8 py-3"
                       Style="background-color: white; color: #10b981;"
                       OnClick="ShowSignup">
                Start Tracking for Free
            </MudButton>
        </div>
    </div>

    <!-- FOOTER -->
    <MudPaper Class="bg-gray-900 py-12 text-center" Square="true" Style="width:100vw; overflow-x:hidden;">
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="mb-6">
            <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Success" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="font-semibold text-white">
                AllowanceTrack
            </MudText>
        </MudStack>

        <MudText Typo="Typo.body2" Class="mb-4 text-gray-400">
            Smart allowance tracking for students
        </MudText>
        <MudText Typo="Typo.caption" Class="text-gray-500">
            © 2025 AllowanceTrack. All rights reserved.
        </MudText>
    </MudPaper>
 </div>
