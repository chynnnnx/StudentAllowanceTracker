@page "/allowances"
@inherits AllowancesBase

<div class="page-container">

    <div class="page-header">
        <div>
            <MudText Typo="Typo.h4" Class="header-title">Allowances</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary">Manage your income sources</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog"
                   Class="btn-add-allowance">
            Add Allowance
        </MudButton>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <MudProgressCircular Color="Color.Success" Indeterminate="true" />
            <MudText Typo="Typo.body2" Class="text-secondary loading-text">Loading your allowances...</MudText>
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <div class="summary-cards">

            <MudCard Class="summary-card-primary">
                <MudCardContent Class="summary-card-content">
                    <MudText Typo="Typo.body2" Class="summary-primary-label">Total Remaining</MudText>
                    <MudText Typo="Typo.h4" Class="summary-primary-value">₱@GetTotalRemaining().ToString("N2")</MudText>
                    <MudText Typo="Typo.caption" Class="summary-primary-subtitle">
                        of ₱@allowances.Sum(a => a.Amount).ToString("N2") total
                    </MudText>
                </MudCardContent>
            </MudCard>

            <MudCard Class="summary-card-white">
                <MudCardContent Class="summary-card-content">
                    <MudText Typo="Typo.body2" Class="text-secondary summary-label">This Month</MudText>
                    <MudText Typo="Typo.h4" Class="summary-white-value">₱@GetThisMonthTotal().ToString("N2")</MudText>
                </MudCardContent>
            </MudCard>

            <MudCard Class="summary-card-white">
                <MudCardContent Class="summary-card-content">
                    <MudText Typo="Typo.body2" Class="text-secondary summary-label">Active Allowances</MudText>
                    <MudText Typo="Typo.h4" Class="summary-white-value">@allowances.Count(IsActive)</MudText>
                </MudCardContent>
            </MudCard>

        </div>

        <MudCard Class="allowance-list-card">

            <div class="allowance-list-header">
                <MudText Typo="Typo.h6" Class="allowance-list-title">Your Allowances</MudText>
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton Style="@GetFilterButtonStyle(showAll)"
                               OnClick="@(() => showAll = true)">
                        All
                    </MudButton>
                    <MudButton Style="@GetFilterButtonStyle(!showAll)"
                               OnClick="@(() => showAll = false)">
                        Active Only
                    </MudButton>
                </MudButtonGroup>
            </div>

            @if (GetFilteredAllowances().Any())
            {
                <div class="allowances-container">
                    @foreach (var allowance in GetFilteredAllowances())
                    {
                        var active = IsActive(allowance);
                        var remaining = GetAllowanceRemaining(allowance.AllowanceID);
                        var spent = GetAllowanceSpent(allowance.AllowanceID);
                        var percentage = GetPercentageUsed(allowance.AllowanceID);

                        <div class="@(active ? "allowance-item-active" : "allowance-item-inactive")">
                            <div class="allowance-item-header">
                                <div class="allowance-info">
                                    <MudIcon Icon="@GetFrequencyIcon(allowance.Type)"
                                             Style="@GetIconStyle(active)" />
                                    <div>
                                        <MudText Typo="Typo.body1" Class="allowance-description">@allowance.Description</MudText>
                                        <MudText Typo="Typo.body2" Class="text-secondary">
                                            @GetFrequencyLabel(allowance.Type) • @(active ? "Active" : "Ended")
                                        </MudText>
                                        @if (!active && allowance.EndDate.HasValue)
                                        {
                                            <MudText Typo="Typo.caption" Class="text-tertiary">
                                                Ended: @allowance.EndDate.Value.ToString("MMM dd, yyyy")
                                            </MudText>
                                        }
                                        else if (active)
                                        {
                                            <MudText Typo="Typo.caption" Class="text-tertiary">
                                                Started: @allowance.StartDate.ToString("MMM dd, yyyy")
                                            </MudText>
                                        }
                                    </div>
                                </div>
                                <div class="allowance-actions">
                                    <div class="allowance-amount">
                                        <MudText Typo="Typo.h6" Style="@GetAmountStyle(active)">
                                            ₱@allowance.Amount.ToString("N2")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="text-secondary">@GetFrequencyUnit(allowance.Type)</MudText>
                                    </div>
                                    <div class="allowance-buttons">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Class="btn-edit"
                                                       OnClick="@(() => OpenEditDialog(allowance))"
                                                       Title="Edit allowance" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Class="btn-delete"
                                                       OnClick="@(() => DeleteAllowance(allowance))"
                                                       Title="Delete allowance" />
                                    </div>
                                </div>
                            </div>

                            <div class="allowance-balance">
                                <div class="balance-info">
                                    <div>
                                        <MudText Typo="Typo.body2" Class="text-secondary balance-label">
                                            @(spent > allowance.Amount ? "Overspent by" : "Balance")
                                        </MudText>
                                        <MudText Typo="Typo.h6" Style="@($"color: {GetBalanceTextColor(remaining, spent, allowance.Amount)}; font-weight: 600;")">
                                            @if (spent > allowance.Amount)
                                            {
                                                <span>₱@((spent - allowance.Amount).ToString("N2"))</span>
                                            }
                                            else
                                            {
                                                <span>₱@remaining.ToString("N2")</span>
                                            }
                                        </MudText>
                                    </div>
                                    <div class="balance-spent">
                                        <MudText Typo="Typo.body2" Class="text-secondary balance-label">Spent</MudText>
                                        <MudText Typo="Typo.body1" Class="balance-spent-value">
                                            ₱@spent.ToString("N2")
                                        </MudText>
                                    </div>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@GetBalanceColor(remaining, spent, allowance.Amount)"
                                             Class="balance-chip">
                                        @percentage%
                                    </MudChip>
                                </div>
                                <MudProgressLinear Color="@GetBalanceColor(remaining, spent, allowance.Amount)"
                                                   Value="@percentage"
                                                   Size="Size.Medium"
                                                   Class="rounded" />

                                @if (spent >= allowance.Amount)
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" NoIcon="false">
                                        This allowance has been fully spent!
                                    </MudAlert>
                                }
                                else if (remaining < 100)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" NoIcon="false">
                                        Running low! Less than ₱100 remaining.
                                    </MudAlert>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountBalanceWallet"
                             Class="empty-state-icon" />
                    <MudText Typo="Typo.h6" Class="text-secondary empty-state-title">
                        @(showAll ? "No allowances yet" : "No active allowances")
                    </MudText>
                    <MudText Typo="Typo.body2" Class="text-tertiary">
                        @(showAll ? "Click 'Add Allowance' to get started" : "All your allowances have ended")
                    </MudText>
                </div>
            }

        </MudCard>
    }

</div>