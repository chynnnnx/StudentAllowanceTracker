@page "/expenses"
@inherits ExpensesBase
<div class="page-container-lg">

    <div class="page-header">
        <div>
            <MudText Typo="Typo.h4" Class="header-title">
                Expenses
            </MudText>
            <MudText Typo="Typo.body2" Class="text-secondary">
                Track your spending
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog"
                   Class="btn-add-allowance">
            Add Expense
        </MudButton>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <MudProgressCircular Color="Color.Success" Indeterminate="true" />
            <MudText Typo="Typo.body2" Class="text-secondary loading-text">Loading expenses...</MudText>
        </div>
    }
    else
    {
        <div class="expenses-summary-grid">
            <MudCard Class="summary-card-primary">
                <MudCardContent Class="summary-card-content">
                    <MudText Typo="Typo.body2" Class="summary-primary-label expenses-summary-label">This Month</MudText>
                    <MudText Typo="Typo.h4" Class="summary-primary-value expenses-summary-value">₱@GetThisMonthTotal().ToString("N2")</MudText>
                </MudCardContent>
            </MudCard>

            <MudCard Class="summary-card-white">
                <MudCardContent Class="summary-card-content">
                    <MudText Typo="Typo.body2" Class="text-secondary expenses-summary-label">Today</MudText>
                    <MudText Typo="Typo.h4" Class="summary-white-value expenses-summary-value">₱@GetTodayTotal().ToString("N2")</MudText>
                </MudCardContent>
            </MudCard>

            <MudCard Class="summary-card-white expenses-total-items-card">
                <MudCardContent Class="summary-card-content">
                    <MudText Typo="Typo.body2" Class="text-secondary expenses-summary-label">Total Items</MudText>
                    <MudText Typo="Typo.h4" Class="summary-white-value expenses-summary-value">@expenses.Count</MudText>
                </MudCardContent>
            </MudCard>
        </div>

  
        <MudCard Class="allowance-list-card">
            <div class="expenses-filter-bar">
                <MudText Typo="Typo.h6" Class="allowance-list-title">Your Expenses</MudText>

                <div class="expenses-filter-controls">
                    <MudSelect T="string"
                               @bind-Value="selectedCategory"
                               Label="Category"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Clearable="true"
                               Class="expenses-filter-select">
                        @foreach (var category in categories)
                        {
                            <MudSelectItem Value="@category.CategoryName">@category.CategoryName</MudSelectItem>
                        }
                    </MudSelect>

                    <MudDateRangePicker @bind-DateRange="dateRange"
                                        Label="Date Range"
                                        Variant="Variant.Outlined"
                                        Dense="true"
                                        Clearable="true"
                                        Color="Color.Success"
                                        Class="expenses-filter-daterange" />
                </div>
            </div>

            <!-- Expenses Table -->
            @if (GetFilteredExpenses().Any())
            {
                <MudDataGrid T="ExpenseDTO"
                             Items="GetFilteredExpenses()"
                             Hover="true"
                             Bordered="true"
                             Striped="true"
                             Class="rounded-xl">

                    <Columns>
                        <TemplateColumn T="ExpenseDTO" Title="Date">
                            <CellTemplate Context="cell">
                                @cell.Item.Date.ToString("MMM dd, yyyy")
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn T="ExpenseDTO" Title="Description">
                            <CellTemplate Context="cell">
                                @cell.Item.Description
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn T="ExpenseDTO" Title="Category">
                            <CellTemplate Context="cell">
                                @{
                                    var category = categories.FirstOrDefault(c => c.CategoryID == cell.Item.CategoryID)?.CategoryName ?? "";
                                }
                                <MudChip T="string" Size="Size.Small"
                                         Style="@($"background-color:{GetCategoryColor(category)}15; color:{GetCategoryColor(category)}; font-weight:500;")">
                                    <div class="flex items-center gap-1">
                                        <MudIcon Icon="@GetCategoryIcon(category)" Size="Size.Small" />
                                        <span>@category</span>
                                    </div>
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn T="ExpenseDTO" Title="Amount" Align="Align.Right">
                            <CellTemplate Context="cell">
                                ₱@cell.Item.Amount.ToString("N2")
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn T="ExpenseDTO" Title="" Align="Align.Right">
                            <CellTemplate Context="cell">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               Class="btn-edit" OnClick="@(() => OpenEditDialog(cell.Item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Class="btn-delete" OnClick="@(() => DeleteExpense(cell.Item))" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>

                    <PagerContent>
                        <MudDataGridPager T="ExpenseDTO" />
                    </PagerContent>
                </MudDataGrid>
            }
            else
            {
                <div class="empty-state">
                    <MudIcon Icon="@Icons.Material.Outlined.Receipt"
                             Class="empty-state-icon" />
                    <MudText Typo="Typo.h6" Class="text-secondary empty-state-title">No expenses found</MudText>
                    <MudText Typo="Typo.body2" Class="text-tertiary">
                        @((!string.IsNullOrEmpty(selectedCategory) || dateRange != null)
                            ? "Try adjusting your filters"
                            : "Click 'Add Expense' to start tracking")
                    </MudText>
                </div>
            }
        </MudCard>
    }
</div>