@page "/goals"
@inherits GoalsBase

<div class="max-w-7xl mx-auto px-4 py-6">

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-semibold text-gray-900 mb-1">Savings Goals</h1>
            <p class="text-sm text-gray-500">Set and track your financial goals</p>
        </div>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialog"
                   Class="gradient-primary px-6 py-3 rounded-lg font-medium"
                   Style="color: white; text-transform: none;">
            Create Goal
        </MudButton>
    </div>

    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center py-16">
            <MudProgressCircular Color="Color.Success" Indeterminate="true" />
            <p class="text-sm text-gray-500 mt-4">Loading goals...</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

            <MudPaper Class="gradient-primary" Style="border-radius: 1rem; padding: 0.75rem;" Elevation="0">
                <MudText Class="summary-primary-label">Total Saved</MudText>
                <MudText Class="summary-primary-value">₱@GetTotalSaved().ToString("N2")</MudText>
            </MudPaper>

            <MudPaper Style="background: white; border: 2px solid hsl(162, 41.8%, 89.2%); border-radius: 1rem; padding: 0.75rem;" Elevation="0">
                <MudText Class="summary-label">Total Target</MudText>
                <MudText Style="color: rgb(17, 24, 39); font-size: 1.875rem; font-weight: 700; word-break: break-word; line-height: 1;">₱@GetTotalTarget().ToString("N2")</MudText>
            </MudPaper>

            <MudPaper Style="background: white; border: 2px solid hsl(162, 41.8%, 89.2%); border-radius: 1rem; padding: 0.75rem;" Elevation="0">
                <MudText Class="summary-label">Active Goals</MudText>
                <MudText Style="color: rgb(17, 24, 39); font-size: 1.875rem; font-weight: 700; line-height: 1;">@goals.Count(g => !g.IsCompleted)</MudText>
            </MudPaper>

            <MudPaper Style="background: white; border: 2px solid hsl(162, 41.8%, 89.2%); border-radius: 1rem; padding: 0.75rem;" Elevation="0">
                <MudText Class="summary-label">Completed</MudText>
                <MudText Style="color: rgb(17, 24, 39); font-size: 1.875rem; font-weight: 700; line-height: 1;">@goals.Count(g => g.IsCompleted)</MudText>
            </MudPaper>

        </div>

        <div class="mb-6">
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton OnClick="@(() => showCompleted = false)"
                           Style="@GetFilterStyle(!showCompleted)"
                           Class="@GetFilterClass(!showCompleted)">
                    Active
                </MudButton>
                <MudButton OnClick="@(() => showCompleted = true)"
                           Style="@GetFilterStyle(showCompleted)"
                           Class="@GetFilterClass(showCompleted)">
                    Completed
                </MudButton>
            </MudButtonGroup>
        </div>

        @if (GetFilteredGoals().Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var goal in GetFilteredGoals())
                {
                    var progress = goal.TargetAmount > 0 ? (double)(goal.CurrentAmount / goal.TargetAmount * 100) : 0;
                    var isCompleted = goal.IsCompleted;

                    <MudPaper Class="@($"p-6 border-2 transition-all hover:shadow-lg {(isCompleted ? "needs-border" : "border-primary")}")"
                              Style="cursor: pointer; border-radius: 1rem;"
                              Elevation="0">

                        <div class="flex items-start justify-between mb-6 gap-3">
                            <div class="flex-1">
                                <MudText Typo="Typo.subtitle1" Class="text-gray-900 mb-1 font-semibold">@goal.GoalName</MudText>
                                <MudText Typo="Typo.body2" Class="text-gray-500">@goal.Description</MudText>
                            </div>
                            @if (isCompleted)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                         Size="Size.Medium"
                                         Class="text-success" />
                            }
                        </div>

                        <div class="mb-5">
                            <div class="flex items-center justify-between mb-3">
                                <MudText Typo="Typo.body2" Class="font-medium text-gray-700">Progress</MudText>
                                <MudText Typo="Typo.body2" Class="font-semibold text-success">
                                    @progress.ToString("F1")%
                                </MudText>
                            </div>
                            <MudProgressLinear Color="Color.Success"
                                               Value="@progress"
                                               Size="Size.Medium"
                                               Class="rounded-full" />
                        </div>

                        <div class="flex items-center justify-between mb-5 px-2">
                            <div>
                                <MudText Typo="Typo.caption" Class="text-gray-500 mb-2">Current</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold text-gray-900">₱@goal.CurrentAmount.ToString("N2")</MudText>
                            </div>
                            <div class="text-right">
                                <MudText Typo="Typo.caption" Class="text-gray-500 mb-2">Target</MudText>
                                <MudText Typo="Typo.body1" Class="font-bold text-gray-900">₱@goal.TargetAmount.ToString("N2")</MudText>
                            </div>
                        </div>

                        <div class="mb-5 px-2" style="min-height: 56px;">
                            @if (!isCompleted)
                            {
                                var daysLeft = (goal.TargetDate - DateTime.Today).Days;
                                var suggested = GetSuggestedSavings(goal);
                                var suggestedPerWeek = suggested.perWeek;
                                var suggestedPerMonth = suggested.perMonth;

                                <MudText Typo="Typo.body2" Class="text-gray-700">
                                    Suggested savings:
                                    <span class="font-semibold text-success">
                                        ₱@suggestedPerWeek / week
                                    </span>
                                    or
                                    <span class="font-semibold text-success">
                                        ₱@suggestedPerMonth / month
                                    </span>
                                </MudText>
                            }
                        </div>

                        <MudPaper Class="flex items-center gap-2 mb-5 p-3 rounded-lg needs-bg"
                                  Elevation="0">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday"
                                     Size="Size.Small"
                                     Class="text-success" />
                            <MudText Typo="Typo.body2" Class="text-gray-700">
                                @{
                                    var daysLeft = (goal.TargetDate - DateTime.Today).Days;
                                }
                                @if (isCompleted)
                                {
                                    <span>Completed on @goal.TargetDate.ToString("MMM dd, yyyy")</span>
                                }
                                else if (daysLeft > 0)
                                {
                                    <span>@daysLeft days left</span>
                                }
                                else if (daysLeft == 0)
                                {
                                    <span class="font-semibold">Due today!</span>
                                }
                                else
                                {
                                    <span class="text-red-600 font-semibold">@Math.Abs(daysLeft) days overdue</span>
                                }
                            </MudText>
                        </MudPaper>

                        <div class="flex items-center gap-2">
                            @if (!isCompleted)
                            {
                                <MudButton Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="@(() => AddContribution(goal))"
                                           Class="gradient-primary flex-1 py-2 rounded-lg font-medium"
                                           Style="color: white; text-transform: none;"
                                           Size="Size.Small">
                                    Add Money
                                </MudButton>
                            }
                            else
                            {
                                <MudPaper Class="flex-1 text-center py-2 px-4 rounded-lg font-medium needs-bg text-success"
                                          Elevation="0">
                                    <MudText Typo="Typo.body2">Goal Achieved!</MudText>
                                </MudPaper>
                            }

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Class="text-success"
                                           OnClick="@(() => EditGoal(goal))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Class="text-error"
                                           OnClick="@(() => DeleteGoal(goal))" />
                        </div>

                    </MudPaper>
                }
            </div>
        }
        else
        {
            <MudPaper Class="p-12 border-2 text-center border-primary"
                      Style="border-radius: 1rem;"
                      Elevation="0">
                <MudIcon Icon="@Icons.Material.Outlined.TrackChanges"
                         Class="text-gray-300 mb-4"
                         Style="font-size: 5rem;" />
                <MudText Typo="Typo.h5" Class="font-semibold text-gray-500 mb-2">
                    @(showCompleted ? "No completed goals yet" : "No active goals yet")
                </MudText>
                <MudText Typo="Typo.body2" Class="text-gray-400 mb-6">
                    @(showCompleted ? "Complete your first goal to see it here" : "Start saving towards your dreams")
                </MudText>
                @if (!showCompleted)
                {
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddDialog"
                               Class="gradient-primary px-8 py-3 rounded-lg font-medium"
                               Style="color: white; text-transform: none;">
                        Create Your First Goal
                    </MudButton>
                }
            </MudPaper>
        }

    }

</div>