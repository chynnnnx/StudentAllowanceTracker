@page "/categories"
@inherits CategoryBase

<div class="min-h-screen py-8 px-4 sm:px-6 lg:px-8 page-gradient-bg">
    <div class="max-w-7xl mx-auto">

        <!-- Page Header -->
        <div class="flex items-center justify-between mb-8">
            <div>
                <MudText Typo="Typo.h4" Class="font-bold text-gray-900 mb-2">Categories</MudText>
                <MudText Typo="Typo.body1" Class="text-gray-600">Organize your expenses with the 50/30/20 rule</MudText>
            </div>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog"
                       Class="gradient-primary px-6 py-3 rounded-lg font-medium"
                       Style="color: white; text-transform: none;">
                Add Category
            </MudButton>
        </div>

        <!-- Budget Overview Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
            <!-- Needs (50%) -->
            <MudPaper Class="p-6 border-2 transition-all hover:shadow-lg needs-border needs-bg-gradient"
                      Style="border-radius: 1rem;"
                      Elevation="0">
                <div class="flex items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="p-3 rounded-xl needs-bg">
                            <MudIcon Icon="@Icons.Material.Filled.Home"
                                     Class="needs-color"
                                     Style="font-size: 2rem;" />
                        </div>
                        <div>
                            <MudText Typo="Typo.h6" Class="font-bold text-gray-900 mb-1">Needs</MudText>
                            <MudText Typo="Typo.caption" Class="text-gray-500">50% of budget</MudText>
                        </div>
                    </div>
                    <div class="text-right">
                        <MudText Typo="Typo.h5" Class="font-bold mb-1 needs-color">
                            @needsCategories.Count
                        </MudText>
                        <MudText Typo="Typo.caption" Class="text-gray-600 font-medium">
                            ₱@needsTotal.ToString("N0")
                        </MudText>
                    </div>
                </div>
            </MudPaper>

            <!-- Wants (30%) -->
            <MudPaper Class="p-6 border-2 transition-all hover:shadow-lg wants-border wants-bg-gradient"
                      Style="border-radius: 1rem;"
                      Elevation="0">
                <div class="flex items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="p-3 rounded-xl wants-bg">
                            <MudIcon Icon="@Icons.Material.Filled.Favorite"
                                     Class="wants-color"
                                     Style="font-size: 2rem;" />
                        </div>
                        <div>
                            <MudText Typo="Typo.h6" Class="font-bold text-gray-900 mb-1">Wants</MudText>
                            <MudText Typo="Typo.caption" Class="text-gray-500">30% of budget</MudText>
                        </div>
                    </div>
                    <div class="text-right">
                        <MudText Typo="Typo.h5" Class="font-bold mb-1 wants-color">
                            @wantsCategories.Count
                        </MudText>
                        <MudText Typo="Typo.caption" Class="text-gray-600 font-medium">
                            ₱@wantsTotal.ToString("N0")
                        </MudText>
                    </div>
                </div>
            </MudPaper>

            <!-- Savings (20%) -->
            <MudPaper Class="p-6 border-2 transition-all hover:shadow-lg savings-border savings-bg-gradient"
                      Style="border-radius: 1rem;"
                      Elevation="0">
                <div class="flex items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="p-3 rounded-xl savings-bg">
                            <MudIcon Icon="@Icons.Material.Filled.Savings"
                                     Class="savings-color"
                                     Style="font-size: 2rem;" />
                        </div>
                        <div>
                            <MudText Typo="Typo.h6" Class="font-bold text-gray-900 mb-1">Savings</MudText>
                            <MudText Typo="Typo.caption" Class="text-gray-500">20% of budget</MudText>
                        </div>
                    </div>
                    <div class="text-right">
                        <MudText Typo="Typo.h5" Class="font-bold mb-1 savings-color">
                            @savingsCategories.Count
                        </MudText>
                        <MudText Typo="Typo.caption" Class="text-gray-600 font-medium">
                            ₱@savingsTotal.ToString("N0")
                        </MudText>
                    </div>
                </div>
            </MudPaper>
        </div>

        <!-- Categories by Type -->
        @foreach (var type in Enum.GetValues<CategoryType>())
        {
            var typeCategories = GetPagedCategories(type);
            var (icon, cssClass) = GetTypeStyle(type);

            <MudPaper Class="p-6 mb-6 shadow-sm"
                      Style="border-radius: 1rem; background: white;"
                      Elevation="0">
                <div class="flex items-center gap-3 mb-6 pb-4" style="border-bottom: 2px solid hsl(0, 0%, 95%);">
                    <div class="@($"p-2 rounded-lg {cssClass}-bg")">
                        <MudIcon Icon="@icon" Class="@($"{cssClass}-color")" Style="font-size: 1.5rem;" />
                    </div>
                    <MudText Typo="Typo.h5" Class="font-bold text-gray-900 flex-1">@type.ToString()</MudText>
                    <MudChip T="string" Size="Size.Medium" Class="@($"{cssClass}-bg {cssClass}-color")" Style="font-weight: 600;">
                        @GetCategoriesByType(type).Count @(GetCategoriesByType(type).Count == 1 ? "category" : "categories")
                    </MudChip>
                </div>

                @if (typeCategories.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                        @foreach (var category in typeCategories)
                        {
                            <MudPaper Class="@($"p-5 border-2 transition-all hover:shadow-lg hover:-translate-y-1 {cssClass}-border")"
                                      Style="border-radius: 0.75rem; background: white;"
                                      Elevation="0">
                                <div class="flex items-start justify-between mb-4 gap-3">
                                    <div class="flex-1 min-w-0">
                                        <MudText Typo="Typo.subtitle1" Class="font-bold text-gray-900 mb-2 truncate">
                                            @category.CategoryName
                                        </MudText>
                                        @if (category.BudgetAmount.HasValue)
                                        {
                                            <div class="flex items-baseline gap-2">
                                                <MudText Typo="Typo.caption" Class="text-gray-500">Budget:</MudText>
                                                <MudText Typo="Typo.body2" Class="@($"font-bold {cssClass}-color")">
                                                    ₱@category.BudgetAmount.Value.ToString("N2")
                                                </MudText>
                                            </div>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Class="text-gray-400 italic">
                                                No budget set
                                            </MudText>
                                        }
                                    </div>
                                    <MudChip T="string" Size="Size.Small"
                                             Class="@($"{cssClass}-bg {cssClass}-color px-3")"
                                             Style="font-weight: 500; flex-shrink: 0;">
                                        @type.ToString()
                                    </MudChip>
                                </div>

                                <div class="flex items-center gap-2 pt-4 mt-2" style="border-top: 1px solid hsl(0, 0%, 92%);">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Medium"
                                                   Class="@($"{cssClass}-color hover:bg-opacity-10")"
                                                   OnClick="@(() => EditCategory(category))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Medium"
                                                   Class="text-error hover:bg-opacity-10"
                                                   OnClick="@(() => DeleteCategory(category))" />
                                </div>
                            </MudPaper>
                        }
                    </div>

                    @if (GetTotalPages(type) > 1)
                    {
                        <div class="flex justify-center items-center gap-4 mt-6 pt-6" style="border-top: 1px solid hsl(0, 0%, 92%);">
                            <MudButton Variant="Variant.Outlined"
                                       Disabled="@(currentPages[type] == 0)"
                                       OnClick="@(() => ChangePage(type, currentPages[type] - 1))"
                                       Class="@($"{cssClass}-border {cssClass}-color px-6")"
                                       Style="text-transform: none;">
                                Previous
                            </MudButton>

                            <MudText Typo="Typo.body2" Class="font-medium text-gray-600 px-4">
                                Page @(currentPages[type] + 1) of @GetTotalPages(type)
                            </MudText>

                            <MudButton Variant="Variant.Outlined"
                                       Disabled="@(currentPages[type] + 1 >= GetTotalPages(type))"
                                       OnClick="@(() => ChangePage(type, currentPages[type] + 1))"
                                       Class="@($"{cssClass}-border {cssClass}-color px-6")"
                                       Style="text-transform: none;">
                                Next
                            </MudButton>
                        </div>
                    }
                }
                else
                {
                    <MudPaper Class="@($"p-10 text-center border-2 border-dashed transition-all hover:border-solid {cssClass}-border {cssClass}-bg")"
                              Style="border-radius: 0.75rem;"
                              Elevation="0">
                        <div class="p-4 rounded-full inline-block mb-4" style="background-color: white;">
                            <MudIcon Icon="@icon" Class="@($"{cssClass}-color")" Style="font-size: 3rem; opacity: 0.6;" />
                        </div>
                        <MudText Typo="Typo.h6" Class="text-gray-700 mb-2 font-semibold">
                            No @type.ToString().ToLower() categories yet
                        </MudText>
                        <MudText Typo="Typo.body2" Class="text-gray-500 mb-4">
                            Start organizing your expenses by adding a category
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenAddDialog"
                                   Class="font-medium px-6 py-2 shadow-md"
                                   Style="@($"text-transform: none; background-color: var(--color-{cssClass}); color: white;")">
                            Add @type.ToString() Category
                        </MudButton>
                    </MudPaper>
                }
            </MudPaper>
        }
    </div>
</div>