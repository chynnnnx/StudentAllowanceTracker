@page "/categories"
@inherits CategoryBase

<div style="max-width: 1200px; margin: 0 auto;">
    <div class="mx-auto max-w-7xl">

        <div class="mb-8 flex items-center justify-between">
            <div>
                <MudText Typo="Typo.h4" Class="mb-2 font-bold text-gray-900">Categories</MudText>
                <MudText Typo="Typo.body1" Class="text-gray-600">
                    @if (currentBudget != null)
                    {
                        <text>Organize your expenses with your @needsPercentage.ToString("F0")/@wantsPercentage.ToString("F0")/@savingsPercentage.ToString("F0") budget plan</text>
                    }
                    else
                    {
                        <text>Organize your expenses by category</text>
                    }
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog"
                       Class="gradient-primary rounded-lg px-6 py-3 font-medium"
                       Style="color: white; text-transform: none;">
                Add Category
            </MudButton>
        </div>

       
        <div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-3">
          
            <MudPaper Class="needs-border needs-bg-gradient border-2 p-6 transition-all hover:shadow-lg"
                      Style="border-radius: 1rem;"
                      Elevation="0">
                <div class="flex items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="needs-bg rounded-xl p-3">
                            <MudIcon Icon="@Icons.Material.Filled.Home"
                                     Class="needs-color"
                                     Style="font-size: 2rem;" />
                        </div>
                        <div>
                            <MudText Typo="Typo.h6" Class="mb-1 font-bold text-gray-900">Needs</MudText>
                            <MudText Typo="Typo.caption" Class="text-gray-500">@needsPercentage.ToString("F0")% of budget</MudText>
                        </div>
                    </div>
                    <div class="text-right">
                        <MudText Typo="Typo.h5" Class="needs-color mb-1 font-bold">
                            @needsCategories.Count
                        </MudText>
                        <MudText Typo="Typo.caption" Class="font-medium text-gray-600">
                            ₱@needsTotal.ToString("N0")
                        </MudText>
                    </div>
                </div>
            </MudPaper>

            <MudPaper Class="wants-border wants-bg-gradient border-2 p-6 transition-all hover:shadow-lg"
                      Style="border-radius: 1rem;"
                      Elevation="0">
                <div class="flex items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="wants-bg rounded-xl p-3">
                            <MudIcon Icon="@Icons.Material.Filled.Favorite"
                                     Class="wants-color"
                                     Style="font-size: 2rem;" />
                        </div>
                        <div>
                            <MudText Typo="Typo.h6" Class="mb-1 font-bold text-gray-900">Wants</MudText>
                            <MudText Typo="Typo.caption" Class="text-gray-500">@wantsPercentage.ToString("F0")% of budget</MudText>
                        </div>
                    </div>
                    <div class="text-right">
                        <MudText Typo="Typo.h5" Class="wants-color mb-1 font-bold">
                            @wantsCategories.Count
                        </MudText>
                        <MudText Typo="Typo.caption" Class="font-medium text-gray-600">
                            ₱@wantsTotal.ToString("N0")
                        </MudText>
                    </div>
                </div>
            </MudPaper>

            <MudPaper Class="savings-border savings-bg-gradient border-2 p-6 transition-all hover:shadow-lg"
                      Style="border-radius: 1rem;"
                      Elevation="0">
                <div class="flex items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="savings-bg rounded-xl p-3">
                            <MudIcon Icon="@Icons.Material.Filled.Savings"
                                     Class="savings-color"
                                     Style="font-size: 2rem;" />
                        </div>
                        <div>
                            <MudText Typo="Typo.h6" Class="mb-1 font-bold text-gray-900">Savings</MudText>
                            <MudText Typo="Typo.caption" Class="text-gray-500">@savingsPercentage.ToString("F0")% of budget</MudText>
                        </div>
                    </div>
                    <div class="text-right">
                        <MudText Typo="Typo.h5" Class="savings-color mb-1 font-bold">
                            @savingsCategories.Count
                        </MudText>
                        <MudText Typo="Typo.caption" Class="font-medium text-gray-600">
                            ₱@savingsTotal.ToString("N0")
                        </MudText>
                    </div>
                </div>
            </MudPaper>
        </div>

      
        @foreach (var type in Enum.GetValues<CategoryType>())
        {
            var typeCategories = GetPagedCategories(type);
            var (icon, cssClass) = GetTypeStyle(type);

            <MudPaper Class="mb-6 p-6 shadow-sm"
                      Style="border-radius: 1rem; background: white;"
                      Elevation="0">
                <div class="mb-6 flex items-center gap-3 pb-4" style="border-bottom: 2px solid hsl(0, 0%, 95%);">
                    <div class="@($"p-2 rounded-lg {cssClass}-bg")">
                        <MudIcon Icon="@icon" Class="@($"{cssClass}-color")" Style="font-size: 1.5rem;" />
                    </div>
                    <MudText Typo="Typo.h5" Class="flex-1 font-bold text-gray-900">@type.ToString()</MudText>
                    <MudChip T="string" Size="Size.Medium" Class="@($"{cssClass}-bg {cssClass}-color")" Style="font-weight: 600;">
                        @GetCategoriesByType(type).Count @(GetCategoriesByType(type).Count == 1 ? "category" : "categories")
                    </MudChip>
                </div>

                @if (typeCategories.Any())
                {
                    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
                        @foreach (var category in typeCategories)
                        {
                            <MudPaper Class="@($"p-5 border-2 transition-all hover:shadow-lg hover:-translate-y-1 {cssClass}-border")"
                                      Style="border-radius: 0.75rem; background: white;"
                                      Elevation="0">
                                <div class="mb-4 flex items-start justify-between gap-3">
                                    <div class="min-w-0 flex-1">
                                        <MudText Typo="Typo.subtitle1" Class="mb-2 truncate font-bold text-gray-900">
                                            @category.CategoryName
                                        </MudText>
                                        @if (category.BudgetAmount.HasValue)
                                        {
                                            <div class="flex items-baseline gap-2">
                                                <MudText Typo="Typo.caption" Class="text-gray-500">Budget:</MudText>
                                                <MudText Typo="Typo.body2" Class="@($"font-bold {cssClass}-color")">
                                                    ₱@category.BudgetAmount.Value.ToString("N2")
                                                </MudText>
                                            </div>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Class="text-gray-400 italic">
                                                No budget set
                                            </MudText>
                                        }
                                    </div>
                                    <MudChip T="string" Size="Size.Small"
                                             Class="@($"{cssClass}-bg {cssClass}-color px-3")"
                                             Style="font-weight: 500; flex-shrink: 0;">
                                        @type.ToString()
                                    </MudChip>
                                </div>

                                <div class="mt-2 flex items-center gap-2 pt-4" style="border-top: 1px solid hsl(0, 0%, 92%);">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Medium"
                                                   Class="@($"{cssClass}-color hover:bg-opacity-10")"
                                                   OnClick="@(() => EditCategory(category))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Medium"
                                                   Class="text-error hover:bg-opacity-10"
                                                   OnClick="@(() => DeleteCategory(category))" />
                                </div>
                            </MudPaper>
                        }
                    </div>

                    @if (GetTotalPages(type) > 1)
                    {
                        <div class="mt-6 flex items-center justify-center gap-4 pt-6" style="border-top: 1px solid hsl(0, 0%, 92%);">
                            <MudButton Variant="Variant.Outlined"
                                       Disabled="@(currentPages[type] == 0)"
                                       OnClick="@(() => ChangePage(type, currentPages[type] - 1))"
                                       Class="@($"{cssClass}-border {cssClass}-color px-6")"
                                       Style="text-transform: none;">
                                Previous
                            </MudButton>

                            <MudText Typo="Typo.body2" Class="px-4 font-medium text-gray-600">
                                Page @(currentPages[type] + 1) of @GetTotalPages(type)
                            </MudText>

                            <MudButton Variant="Variant.Outlined"
                                       Disabled="@(currentPages[type] + 1 >= GetTotalPages(type))"
                                       OnClick="@(() => ChangePage(type, currentPages[type] + 1))"
                                       Class="@($"{cssClass}-border {cssClass}-color px-6")"
                                       Style="text-transform: none;">
                                Next
                            </MudButton>
                        </div>
                    }
                }
                else
                {
                    <MudPaper Class="@($"p-10 text-center border-2 border-dashed transition-all hover:border-solid {cssClass}-border {cssClass}-bg")"
                              Style="border-radius: 0.75rem;"
                              Elevation="0">
                        <div class="mb-4 inline-block rounded-full p-4" style="background-color: white;">
                            <MudIcon Icon="@icon" Class="@($"{cssClass}-color")" Style="font-size: 3rem; opacity: 0.6;" />
                        </div>
                        <MudText Typo="Typo.h6" Class="mb-2 font-semibold text-gray-700">
                            No @type.ToString().ToLower() categories yet
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mb-4 text-gray-500">
                            Start organizing your expenses by adding a category
                        </MudText>
                      
                    </MudPaper>
                }
            </MudPaper>
        }
    </div>
</div>