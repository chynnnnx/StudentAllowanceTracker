@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@using Components.CustomTheme
@using StudentAllowanceTracker.Client.Components.Dialogs.User
<MudThemeProvider Theme="@ThemeColor.Theme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

@if (_isLoading)
{
    <Loader Visible="true" />
}
else
{
    <AuthorizeView Roles="User">
        <Authorized>
            <MudLayout>
                <MudAppBar Elevation="0" Style="background-color: var(--bg-white); border-bottom: 1px solid var(--border-primary);">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                    Style="color: var(--text-icon);"
                    Edge="Edge.Start"
                    OnClick="@DrawerToggle" />

                    <MudSpacer />

                    <div class="flex items-center" style="gap: 0.5rem;">

                        <MudIconButton Icon="@Icons.Material.Outlined.Notifications"
                        Style="color: var(--text-icon);"
                        Size="Size.Medium"
                      OnClick="@OpenNotificationDialog" />
                        

                        <MudIconButton Icon="@Icons.Material.Outlined.HelpOutline"
                        Style="color: var(--text-icon);"
                        Size="Size.Medium" />

                        <MudDivider Vertical="true" FlexItem="true" Style="height: 24px; margin: 0 0.5rem;" />

                        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Text"
                                Style="color: var(--text-icon); text-transform: none; padding: 0.5rem 1rem;"
                                StartIcon="@Icons.Material.Filled.AccountCircle">
                                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                                        <span style="margin-left: 0.5rem;">Account</span>
                                    </MudHidden>
                                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Style="margin-left: 0.25rem;" Size="Size.Small" />
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="Profile">Profile</MudMenuItem>
                                <MudDivider />
                                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Logout</MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </div>
                </MudAppBar>

                <MudDrawer @bind-Open="_drawerOpen"
                Class="white-drawer"
                Elevation="0"
                Style="border-right: 2px solid var(--border-primary);">
                    <NavMenu />
                </MudDrawer>

                <MudMainContent Style="background-color: var(--bg-page);">
                    <div style="padding: 1.5rem;">
                        @Body
                    </div>
                </MudMainContent>
            </MudLayout>
        </Authorized>
        <NotAuthorized>
            <div class="flex flex-col items-center justify-center h-screen text-center">
                <MudText Typo="Typo.h5" Color="Color.Error">You are not authorized to access this page.</MudText>
                <MudText Typo="Typo.body1">
                    Please <MudLink Href="/">log in</MudLink> to continue.
                </MudText>
            </div>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [Inject] private IDialogService DialogService { get; set; }

    private bool _drawerOpen = true;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isLoading = false;
    }

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private async Task Logout()
    {
        _isLoading = true;
        StateHasChanged();
        await LocalStorage.RemoveItemAsync("authToken");
        await LocalStorage.RemoveItemAsync("userRole");
        if (AuthStateProvider is CustomAuthStateProvider customAuth)
            customAuth.NotifyUserLogout();
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private async Task Profile()
    {
        Navigation.NavigateTo("/profile");
    }

    private async Task OpenNotificationDialog()
    {
        var options = new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.ExtraSmall };
        await DialogService.Show<NotificationDialog>("Notifications", options).Result;
    }
}