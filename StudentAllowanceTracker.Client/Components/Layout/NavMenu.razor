<AuthorizeView Roles="User">
    <!-- Top Bar -->
    <div class="topbar flex items-center gap-3">
        <div class="wallet-icon flex items-center justify-center">
            <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="wallet-icon-inner" />
        </div>
        <div class="flex flex-col">
            <MudText Typo="Typo.h6" Class="text-primary font-semibold m-0 leading-tight">
                Student Allowance
            </MudText>
            <MudText Typo="Typo.caption" Class="text-secondary m-0 text-xs">
                Track & Manage
            </MudText>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <!-- Sidebar -->
    <div class="sidebar nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="flex flex-col py-4">
            @foreach (var item in new[]
            {
            new { Href = "dashboard", Icon = Icons.Material.Filled.Home, Label = "Home" },
            new { Href = "allowances", Icon = Icons.Material.Filled.Money, Label = "Allowances" },
            new { Href = "expenses", Icon = Icons.Material.Filled.Receipt, Label = "Track Expenses" },
            new { Href = "goals", Icon = Icons.Material.Filled.Category, Label = "Goals" },
            new { Href = "categories", Icon = Icons.Material.Filled.Category, Label = "Categories" },
            new { Href = "budget", Icon = Icons.Material.Filled.PieChart, Label = "Budget" },
            new { Href = "history", Icon = Icons.Material.Filled.Assessment, Label = "History" },
            new { Href = "settings", Icon = Icons.Material.Filled.Settings, Label = "Settings" }
            })
            {
                <div class="px-3">
                    <NavLink class="nav-link flex items-center px-4 py-3 rounded border-l-4 border-transparent"
                             href="@item.Href" Match="NavLinkMatch.All">
                        <MudIcon Icon="@item.Icon" Class="sidebar-icon mr-3" />
                        <MudText Typo="Typo.body1" Class="text-primary font-normal m-0">
                            @item.Label
                        </MudText>
                    </NavLink>
                </div>
            }

        </nav>
    </div>

</AuthorizeView>
